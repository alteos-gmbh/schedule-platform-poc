flowchart LR
    CALLER["<b>Amazon EKS</b><br/>calling services"]
    FN["<b>AWS Lambda</b><br/>schedule service"]
    DDB[("<b>Amazon DynamoDB</b><br/>schedules and their state")]
    EBS["<b>Amazon EventBridge Scheduler</b><br/>one timer per occurrence"]
    SQS[["<b>Amazon SQS</b><br/>job queues"]]
    DLQ[["<b>Amazon SQS</b><br/>dead-letter queue"]]
    CONSUMER["<b>Amazon EKS</b><br/>consuming services"]

    CALLER -->|"lambda:Invoke, IAM-gated"| FN
    FN <-->|"source of truth"| DDB
    FN -->|"set · move · cancel a timer"| EBS
    EBS -->|"the timer fires"| FN
    FN -->|"one message per fire"| SQS
    SQS --> CONSUMER
    FN -.->|"delivery gave up"| DLQ
