architecture-beta
    group callers(logos:aws-eks)[Calling services on EKS]
    group platform(logos:aws)[Schedule platform]
    group consumers(logos:aws-eks)[Consuming services on EKS]

    service caller(server)[policy and workflow] in callers
    service fn(logos:aws-lambda)[Schedule service] in platform
    service ddb(logos:aws-dynamodb)[Schedules and state] in platform
    service sched(logos:aws-eventbridge)[One timer per occurrence] in platform
    service jobs(logos:aws-sqs)[Job queues] in platform
    service consumer(server)[policy accounting workflow] in consumers

    caller:R --> L:fn
    fn:T <--> B:ddb
    fn:B <--> T:sched
    fn:R --> L:jobs
    jobs:R --> L:consumer
